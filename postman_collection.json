      "item": [
        {
          "name": "1. Add Beneficiary (201 Success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{sourceAccountId}}\",\n  \"beneficiaryAccountNumber\": \"10000002\",\n  \"nickname\": \"Bob Office\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/beneficiaries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "beneficiaries"]
            }
          }
